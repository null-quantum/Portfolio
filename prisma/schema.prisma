// Prisma schema — kept for reference. The portfolio is now fully static
// (no database). The contact form uses a mailto: link, no persistence.
// If you re-add persistence later, configure a real DATABASE_URL (e.g.
// Supabase Postgres) — do NOT use local SQLite in production (Vercel).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
